# API HTTP port
PORT=4009

# Node environment: 'development' uses MONGO_DEV, 'production' uses MONGO_PROD.
NODE_ENV=development

# MongoDB connection URIs.
# IMPORTANT: dev and prod MUST point at SEPARATE databases/clusters.
# Do not share one cluster across environments.
MONGO_DEV=mongodb://localhost:27017/sms_dev
MONGO_PROD=mongodb://localhost:27017/sms_prod

# Allowed CORS origins (comma-separated). REQUIRED in production.
# Example: https://app.example.com,https://admin.example.com
# In development, if empty, any localhost/127.0.0.1 origin is allowed.
CORS_ORIGINS=
