# Copy to `.env.production` on the VPS (gitignored). docker-compose injects these
# into the api + worker containers. NEVER commit the filled-in file.
NODE_ENV=production
PORT=4009

# MongoDB Atlas connection string (production cluster, rotated credentials).
MONGO_PROD=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/sms_prod?retryWrites=true&w=majority

# Comma-separated allowlist — the frontend origins (https), exact match.
CORS_ORIGINS=https://carmoa.store,https://www.carmoa.store
